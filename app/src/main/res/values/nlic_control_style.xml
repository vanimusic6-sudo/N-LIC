<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nlic_canvas">#0D1325</color>
    <color name="nlic_surface">#192239</color>
    <color name="nlic_surface_raised">#202B45</color>
    <color name="nlic_accent">#93BAFF</color>
    <color name="nlic_text">#F1F5FF</color>
    <color name="nlic_muted">#ADBBD8</color>
    <color name="nlic_success">#80D9BE</color>
    <color name="nlic_border">#394966</color>

    <style name="Theme.NlicControl" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nlic_accent</item>
        <item name="colorPrimaryVariant">@color/nlic_accent</item>
        <item name="colorOnPrimary">@color/nlic_canvas</item>
        <item name="colorSecondary">@color/nlic_success</item>
        <item name="colorOnSecondary">@color/nlic_canvas</item>
        <item name="colorSurface">@color/nlic_surface</item>
        <item name="colorOnSurface">@color/nlic_text</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/nlic_canvas</item>
        <item name="android:navigationBarColor">@color/nlic_canvas</item>
        <item name="android:windowBackground">@color/nlic_canvas</item>
        <item name="android:textColorPrimary">@color/nlic_text</item>
        <item name="android:textColorSecondary">@color/nlic_muted</item>
        <item name="materialButtonStyle">@style/NlicButton</item>
    </style>
    <style name="NlicButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="backgroundTint">@color/nlic_accent</item>
    </style>
</resources>
<resources>
    <style name="Theme.ByeDPI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nlic_accent</item>
        <item name="colorPrimaryVariant">@color/nlic_canvas</item>
        <item name="colorOnPrimary">@color/nlic_canvas</item>
        <item name="colorSecondary">@color/nlic_success</item>
        <item name="colorOnSecondary">@color/nlic_canvas</item>
        <item name="colorSurface">@color/nlic_surface</item>
        <item name="colorOnSurface">@color/nlic_text</item>
        <item name="android:windowBackground">@color/nlic_canvas</item>
        <item name="android:statusBarColor">@color/nlic_canvas</item>
        <item name="android:navigationBarColor">@color/nlic_canvas</item>
        <item name="android:textColorPrimary">@color/nlic_text</item>
        <item name="android:textColorSecondary">@color/nlic_muted</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialCardViewStyle">@style/SmallShadowCard</item>
    </style>

    <style name="AppToolbar" parent="Widget.MaterialComponents.Toolbar.Primary" />

    <style name="SmallShadowCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">1dp</item>
    </style>

    <style name="CircleButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">60dp</item>
        <item name="android:textSize">0sp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>

    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <!-- -->
    </style>

    <style name="PillCard">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>

    <string name="nlic_subscriptions_clear_confirm">Xóa vĩnh viễn mọi thuê bao và khóa mã hóa? Cài đặt ByeDPI được giữ lại.</string>
    <string name="nlic_subscriptions_vault_error">Không thể mở kho mã hóa</string>
    <string name="nlic_subscriptions_vault_error_desc">Khóa Android Keystore không khả dụng. Hãy kiểm tra ứng dụng.</string>

    <string name="nlic_auto_label">LIC-Auto · chọn máy chủ</string>
    <string name="nlic_auto_tcp_only">Chỉ kiểm tra khả năng kết nối TCP và độ trễ; đây KHÔNG phải tốc độ VPN.</string>
    <string name="nlic_auto_consent">N-LIC sẽ kết nối trực tiếp tới máy chủ trong thuê bao để đo độ trễ TCP. Không khởi động VPN. Tiếp tục?</string>
    <string name="nlic_auto_results">LIC-Auto · kết quả TCP</string>
    <string name="nlic_auto_ineligible">Máy chủ này không vượt qua cả hai bài kiểm tra TCP hoặc dùng UDP.</string>
    <string name="nlic_bay_label">LIC-Bay · bảo vệ kết nối VPN</string>
    <string name="nlic_bay_phase">Dự kiến: chuyển TCP ngoài của VPN qua ByeDPI SOCKS. Chưa hoạt động; UDP cần giải pháp riêng.</string>
    <string name="nlic_core_preview_warning">LIC-Core BẢN THỬ: APK này có sing-box thử nghiệm. Sử dụng Android VPN/HEV hiện tại. Có thể gặp lỗi tương thích. LIC-Bay là tùy chọn, không bảo đảm vượt chặn.</string>
    <string name="nlic_core_toggle">LIC-Core · kết nối bằng thuê bao</string>
    <string name="nlic_core_missing">APK thông thường không có libbox. Hãy dùng APK Core Preview riêng. ByeDPI cũ không đổi.</string>
    <string name="nlic_core_requires_vpn">Chọn chế độ VPN thay vì Proxy trong cài đặt N-LIC.</string>
    <string name="nlic_core_choose_supported">Trước tiên hãy chọn máy chủ VLESS, VMess, Trojan, Shadowsocks, HY2 hoặc TUIC được hỗ trợ.</string>
    <string name="nlic_core_reconnect">Thay đổi áp dụng ở lần kết nối tiếp theo. Hãy kết nối lại VPN thủ công.</string>
    <string name="nlic_core_bay_toggle">LIC-Bay · bảo vệ kết nối VPN bằng ByeDPI</string>
    <string name="nlic_core_bay_desc">ByeDPI SOCKS chỉ được dùng cho kết nối TCP bên ngoài tới máy chủ VPN. Tắt LIC-Bay nếu kết nối lỗi.</string>
    <string name="nlic_core_bay_udp">Phương pháp TCP của ByeDPI không dùng được cho Hysteria2/TUIC. Hãy chọn máy chủ TCP.</string>
    <string name="nlic_core_profile_check">Kiểm tra cấu hình LIC-Core</string>
    <string name="nlic_core_profile_ready">Thông số đã chuyển thành sing-box JSON. Chưa kiểm tra được VPN thực tế.</string>
    <string name="nlic_core_profile_unsupported">Chưa chọn máy chủ hoặc thông số chưa được hỗ trợ. Không thể kết nối.</string>
    <string name="nlic_core_auto_toggle">LIC-Auto · tự chọn máy chủ VPN hoạt động</string>
    <string name="nlic_core_auto_desc">Trong LIC-Core, sing-box kiểm tra tối đa 12 máy chủ VPN mã hóa qua HTTPS, chọn máy chủ khả dụng có độ trễ thấp hơn và thử lại sau mỗi 10 phút. Không ngắt kết nối hiện tại. Cần Core Preview.</string>
    <string name="nlic_core_connect">Kết nối / áp dụng cài đặt</string>
    <string name="nlic_core_connecting">Đang kiểm tra kết nối VPN…</string>
    <string name="nlic_core_connect_desc">Kết nối lại VPN bằng máy chủ đã chọn, LIC-Auto và LIC-Bay. Trạng thái sẵn sàng được xác minh bằng yêu cầu HTTPS qua đường hầm.</string>

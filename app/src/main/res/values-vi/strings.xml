    <string name="nlic_upstream_credits">ByeByeDPI gốc · romanvht, hufrea, heiher</string>
    <string name="stream_probe_enable">Kiểm tra luồng video (256 KiB)</string>
    <string name="stream_probe_enable_desc">Kiểm tra tải xuống qua SOCKS5 (tùy chọn), phát hiện tốc độ thấp hoặc luồng bị ngắt sau một số kilobyte đầu tiên.</string>
    <string name="stream_probe_url">Liên kết HTTPS của video để kiểm tra</string>
    <string name="stream_probe_url_desc">Dán liên kết googlevideo.com/videoplayback còn hiệu lực hoặc https://speed.cloudflare.com/__down?bytes=262144. URL được xóa khi bắt đầu kiểm tra và không được lưu trong kết quả.</string>
    <string name="nlic_mobile_safe_mtu">Mạng di động: MTU an toàn (thử nghiệm)</string>
    <string name="nlic_mobile_safe_mtu_desc">Giới hạn gói tin ảo ở mức 1280–1400 byte trên mạng di động. Wi-Fi không thay đổi. Nếu kết nối kém đi, hãy tắt và kết nối lại N-LIC.</string>
    <string name="nlic_mobile_ipv6_auto">Mạng di động: định tuyến IPv6 qua N-LIC</string>
    <string name="nlic_mobile_ipv6_auto_desc">Bật tuyến IPv6 qua VPN trên mạng di động có IPv6 ngay cả khi tùy chọn IPv6 chung đang tắt. Wi-Fi không thay đổi. Có thể tắt nếu gặp sự cố.</string>
    <string name="nlic_network_profiles">Chiến lược riêng cho Wi-Fi và mạng di động</string>
    <string name="nlic_network_profiles_desc">Tùy chọn: ghi nhớ lệnh đã chọn thủ công gần nhất cho từng loại mạng và áp dụng ở lần kết nối sau. Không đổi chiến lược khi đang xem video. Mạng không xác định dùng lệnh mặc định.</string>
    <string name="nlic_mobile_dns64_auto">Mạng di động: DNS64/NAT64</string>
    <string name="nlic_mobile_dns64_auto_desc">Trên mạng di động IPv6/NAT64, sử dụng DNS của nhà mạng nếu bạn chưa chọn DNS riêng để giữ khả năng chuyển đổi DNS64. Wi-Fi và DNS tùy chỉnh không thay đổi. Có thể tắt.</string>
    <string name="nlic_network_health">Chẩn đoán kết nối di động</string>
    <string name="nlic_network_health_desc">Kiểm tra TCP tới YouTube và Telegram và tải 16/256 KiB. Nếu Android ẩn mạng vật lý, bài kiểm tra sử dụng tuyến mặc định hệ thống và ghi rõ điều này. Chỉ chạy khi bạn nhấn.</string>
    <string name="nlic_network_health_running">Đang kiểm tra mạng vật lý, kết nối TCP và tải xuống...</string>
    <string name="nlic_restart_on_network_change">Kết nối lại khi chuyển Wi-Fi ↔ dữ liệu di động</string>
    <string name="nlic_restart_on_network_change_desc">Tùy chọn: khởi động lại VPN N-LIC khi mạng vật lý thay đổi để áp dụng cài đặt phù hợp. Các kết nối hiện tại sẽ bị ngắt. Không ảnh hưởng chế độ Proxy.</string>
    <string name="nlic_network_health_paused_title">Android ẩn mạng vật lý</string>
    <string name="nlic_network_health_paused_warning">N-LIC đang chạy dưới dạng VPN nhưng Android không hiển thị mạng vật lý để chẩn đoán. Tạm ngắt N-LIC, kiểm tra mạng trực tiếp rồi kết nối lại VPN? Trong lúc thử nghiệm N-LIC sẽ ngắt: các ứng dụng khác cũng có thể truy cập mạng mà không qua bộ lọc và các kết nối hiện tại sẽ bị gián đoạn. Các ứng dụng VPN khác không bị thay đổi.</string>
    <string name="nlic_network_health_paused_confirm">Ngắt, kiểm tra, khôi phục</string>
    <string name="nlic_network_health_timeout">Kiểm tra mạng đã hết thời gian. Hãy kiểm tra dữ liệu di động và thử lại.</string>
    <string name="nlic_network_health_restored">Đã khôi phục VPN N-LIC sau khi chẩn đoán.</string>
    <string name="nlic_network_health_restore_failed">Không thể tự động khôi phục VPN N-LIC. Hãy kết nối lại thủ công.</string>
    <string name="nlic_network_health_app_access">Quyền truy cập mạng của ứng dụng</string>
    <string name="nlic_subscriptions_title">Thuê bao và máy chủ</string>
    <string name="nlic_subscriptions_phase">N-LIC 1.9 — nền tảng thử nghiệm</string>
    <string name="nlic_subscriptions_phase_desc">Đã hỗ trợ nhập máy chủ và thử TCP. Chưa hỗ trợ kết nối VPN qua máy chủ nhập vào; ByeDPI cũ không thay đổi.</string>
    <string name="nlic_subscriptions_unsupported">Bộ nhớ mã hóa yêu cầu Android 6 trở lên</string>
    <string name="nlic_subscriptions_add_url">Thêm thuê bao HTTPS</string>
    <string name="nlic_subscriptions_url_hint">Dán liên kết thuê bao. Không chuyển hướng. Chỉ cập nhật thủ công.</string>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:background="@color/nlic_canvas">
 <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
  android:layout_width="match_parent" android:layout_height="56dp" app:title="N-LIC"
  app:titleTextColor="@color/nlic_text" android:background="@color/nlic_canvas"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
   android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
   android:paddingTop="20dp" android:paddingBottom="26dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton android:id="@+id/nlic_mode_bypass"
     style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp"
     android:layout_height="50dp" android:layout_weight="1" android:text="@string/nlic_mode_local"
     android:textAllCaps="false" android:textSize="14sp" app:cornerRadius="16dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/nlic_mode_subscription"
     style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp"
     android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="9dp"
     android:text="@string/nlic_mode_subscription" android:textAllCaps="false" android:textSize="14sp" app:cornerRadius="16dp"/>
   </LinearLayout>
   <TextView android:id="@+id/nlic_status_label" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="37dp"
    android:text="@string/nlic_control_disconnected" android:textSize="29sp"
    android:textColor="@color/nlic_text" android:fontFamily="sans-serif-medium"/>
   <TextView android:id="@+id/nlic_status_message" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="9dp"
    android:text="@string/nlic_control_status_hint" android:textSize="14sp"
    android:textColor="@color/nlic_muted" android:maxLines="4" android:ellipsize="end"/>
   <ProgressBar android:id="@+id/nlic_progress" style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent" android:layout_height="2dp"
    android:layout_marginTop="10dp" android:indeterminate="true" android:visibility="gone"/>
   <TextView android:id="@+id/nlic_stage_label" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="10dp"
    android:textColor="@color/nlic_muted" android:textSize="11sp" android:visibility="gone"/>
   <View android:layout_width="match_parent" android:layout_height="1dp"
    android:layout_marginTop="34dp" android:layout_marginBottom="25dp"
    android:background="@color/nlic_border"/>
   <LinearLayout android:id="@+id/nlic_subscription_panel" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
     android:text="@string/nlic_control_server_title" android:textColor="@color/nlic_text" android:textSize="17sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
     android:orientation="horizontal" android:layout_marginTop="12dp">
     <com.google.android.material.button.MaterialButton android:id="@+id/nlic_server_picker_button"
      style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp"
      android:layout_weight="1" android:layout_height="55dp"
      android:text="@string/nlic_control_select_server" android:textAllCaps="false"
      android:gravity="center_vertical|start" android:textSize="14sp"
      android:maxLines="1" android:ellipsize="end" app:cornerRadius="16dp"/>
     <com.google.android.material.button.MaterialButton android:id="@+id/nlic_manage_profiles"
      style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="55dp"
      android:layout_height="55dp" android:layout_marginStart="8dp" android:text="+"
      android:textSize="22sp" android:textAllCaps="false" app:cornerRadius="16dp"
      android:contentDescription="@string/nlic_profiles_manage"/>
    </LinearLayout>
    <TextView android:id="@+id/nlic_server_hint" android:layout_width="match_parent"
     android:layout_height="wrap_content" android:layout_marginTop="8dp"
     android:textColor="@color/nlic_muted" android:textSize="12sp" android:maxLines="2"/>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/nlic_auto_switch"
     android:layout_width="match_parent" android:layout_height="wrap_content"
     android:layout_marginTop="18dp" android:minHeight="48dp"
     android:text="@string/nlic_control_auto_title" android:textColor="@color/nlic_text"/>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/nlic_bay_switch"
     android:layout_width="match_parent" android:layout_height="wrap_content"
     android:layout_marginTop="4dp" android:minHeight="48dp"
     android:text="@string/nlic_control_bay_title" android:textColor="@color/nlic_text"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/nlic_bypass_panel" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
     android:text="@string/nlic_bypass_explanation" android:textColor="@color/nlic_muted"
     android:textSize="14sp"/>
    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/nlic_adaptive_switch"
     android:layout_width="match_parent" android:layout_height="wrap_content"
     android:layout_marginTop="20dp" android:minHeight="52dp"
     android:text="@string/nlic_home_auto_network" android:textColor="@color/nlic_text"/>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
 <FrameLayout android:layout_width="match_parent" android:layout_height="77dp"
  android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingBottom="22dp">
  <com.google.android.material.button.MaterialButton android:id="@+id/nlic_connect"
   android:layout_width="match_parent" android:layout_height="55dp"
   android:text="@string/nlic_control_connect" android:textAllCaps="false"
   android:textSize="16sp" app:cornerRadius="18dp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/nlic_disconnect"
   android:layout_width="match_parent" android:layout_height="55dp"
   android:text="@string/nlic_core_disconnect" android:textAllCaps="false"
   android:visibility="gone" android:textSize="16sp" app:cornerRadius="18dp"/>
 </FrameLayout>
</LinearLayout>
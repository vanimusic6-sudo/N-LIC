<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nlic_canvas">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/nlic_canvas"
        app:title="@string/nlic_control_title"
        app:titleTextColor="@color/nlic_text"
        app:navigationIconTint="@color/nlic_text" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nlic_mode_label"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/nlic_muted"
                android:textSize="12sp"
                android:letterSpacing="0.01" />

            <!-- One primary surface, two explicit routes: local DPI only
                 or an encrypted remote VPN subscription. -->
            <LinearLayout
                android:id="@+id/nlic_mode_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="12dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_mode_bypass"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="@string/nlic_mode_local"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:maxLines="1"
                    app:cornerRadius="16dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_mode_subscription"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/nlic_mode_subscription"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:maxLines="1"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/nlic_surface"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/nlic_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/nlic_status_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nlic_control_disconnected"
                        android:textColor="@color/nlic_text"
                        android:textSize="25sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:id="@+id/nlic_status_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/nlic_control_status_hint"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/nlic_muted"
                        android:textSize="14sp" />

                    <ProgressBar
                        android:id="@+id/nlic_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/nlic_accent" />

                    <TextView
                        android:id="@+id/nlic_stage_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/nlic_success"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/nlic_bypass_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="23dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nlic_bypass_heading"
                    android:textSize="19sp"
                    android:textColor="@color/nlic_text"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="@string/nlic_bypass_explanation"
                    android:lineSpacingExtra="2dp"
                    android:textSize="14sp"
                    android:textColor="@color/nlic_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nlic_subscription_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="@string/nlic_control_server_title"
                android:textColor="@color/nlic_text"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="14dp"
                android:text="@string/nlic_control_server_subtitle"
                android:textColor="@color/nlic_muted"
                android:textSize="13sp" />

            <!-- A stable, fully accessible single-choice dialog opens from this
                 button. Avoid platform popup-window behaviour that differs
                 across Android 14-17 and display sizes. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nlic_server_picker_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical|start"
                android:text="@string/nlic_control_select_server"
                android:textAllCaps="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                app:cornerRadius="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nlic_manage_profiles"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/nlic_profiles_manage"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="16dp" />

            <TextView
                android:id="@+id/nlic_server_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:textColor="@color/nlic_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_add_subscription"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:text="@string/nlic_control_add_subscription"
                    android:textAllCaps="false"
                    app:cornerRadius="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_add_link"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:text="@string/nlic_control_add_link"
                    android:textAllCaps="false"
                    app:cornerRadius="17dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_add_file"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:text="@string/nlic_home_file_import"
                    android:textAllCaps="false"
                    app:cornerRadius="17dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_refresh_now"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:text="@string/nlic_home_refresh_subscriptions"
                    android:textAllCaps="false"
                    app:cornerRadius="17dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:id="@+id/nlic_supported_protocols"
                android:visibility="gone"
                android:text="@string/nlic_home_supported_protocols"
                android:textSize="12sp"
                android:textColor="@color/nlic_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/nlic_control_features_title"
                android:textColor="@color/nlic_text"
                android:textSize="19sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/nlic_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="17dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/nlic_auto_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nlic_control_auto_title"
                        android:textColor="@color/nlic_text"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/nlic_control_auto_desc"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/nlic_muted"
                        android:textSize="13sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/nlic_border" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/nlic_bay_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nlic_control_bay_title"
                        android:textColor="@color/nlic_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/nlic_bay_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/nlic_control_bay_desc"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/nlic_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            </LinearLayout><!-- end subscription panel -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/nlic_adaptive_heading"
                android:textColor="@color/nlic_text"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/nlic_surface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/nlic_adaptive_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/nlic_home_auto_network"
                        android:textSize="15sp"
                        android:textColor="@color/nlic_text" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/nlic_home_auto_network_details"
                        android:lineSpacingExtra="2dp"
                        android:textSize="12sp"
                        android:textColor="@color/nlic_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nlic_expand_advanced"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="@string/nlic_control_more"
                android:textAllCaps="false"
                android:textColor="@color/nlic_accent" />

            <LinearLayout
                android:id="@+id/nlic_advanced_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_privacy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/nlic_privacy_title"
                    android:textAllCaps="false" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/nlic_privacy_description"
                    android:textColor="@color/nlic_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_help"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/nlic_ui_help"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_refresh"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/nlic_subscriptions_refresh"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_tcp_check"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/nlic_auto_label"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_legacy_mode"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/nlic_ui_legacy_action"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nlic_clear"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/nlic_subscriptions_clear"
                    android:textAllCaps="false" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/nlic_core_preview_warning"
                    android:textColor="@color/nlic_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp"
        android:background="@color/nlic_canvas">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nlic_connect"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/nlic_control_connect"
            android:textSize="16sp"
            android:textAllCaps="false"
            app:cornerRadius="20dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nlic_disconnect"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/nlic_core_disconnect"
            android:textAllCaps="false"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>